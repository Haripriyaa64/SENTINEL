APP_NAME=IDS Dark Web Monitoring Platform
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_DB=ids_platform
POSTGRES_USER=ids_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DATABASE_URL=postgresql+psycopg://ids_app:REPLACE_WITH_STRONG_PASSWORD@db:5432/ids_platform

